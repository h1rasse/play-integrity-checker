PORT=8080
# The Android package name registered in Google Play Console.
ANDROID_PACKAGE_NAME=com.h1rasse.playintegritychecker
# Set this to true only for local UI development without Google credentials.
MOCK_MODE=true
# For real verification, set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
